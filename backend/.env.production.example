APP_ENV=production

# PostgreSQL is private to the Docker Compose network. Use a long random
# alphanumeric password here so it can also be used safely in DATABASE_URL.
POSTGRES_DB=eve_industry
POSTGRES_USER=eve_industry
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql+psycopg://eve_industry:CHANGE_ME_TO_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD@postgres:5432/eve_industry
DATABASE_TIMEOUT_SECONDS=3
CALCULATION_MAX_BODY_BYTES=1048576
CALCULATION_RATE_LIMIT_REQUESTS=30
CALCULATION_RATE_LIMIT_WINDOW_SECONDS=60
CALCULATION_MAX_CONCURRENT_REQUESTS=4

# The public website is currently hosted at this origin. Add another origin only
# if the frontend is intentionally served from somewhere else.
CORS_ORIGINS=https://interstellar.systems

ESI_BASE_URL=https://esi.evetech.net
# Keep this pinned to the ESI compatibility date reviewed by the application.
ESI_COMPATIBILITY_DATE=2026-08-13
# Replace the contact value with a real repository URL or monitored email.
ESI_USER_AGENT=ITS-S-EVE-Industry/0.1 (https://github.com/Kana523/ITSS_website)

MARKET_REGION_ID=10000002
MARKET_LOCATION_ID=60003760
MARKET_LOCATION_NAME=Jita IV - Moon 4 - Caldari Navy Assembly Plant
